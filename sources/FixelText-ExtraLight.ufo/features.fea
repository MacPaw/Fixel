  sub six.osf by six.tf;
  sub six by six.tf;
  sub three.osf by three.tf;
  sub three by three.tf;
  sub two.osf by two.tf;
  sub two by two.tf;
  sub zero.osf by zero.tf;
  sub zero by zero.tf;
#< feature
} lnum;
feature pnum {
